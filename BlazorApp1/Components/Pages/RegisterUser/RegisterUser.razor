@page "/auth/register"
@using Core.Entities
@rendermode InteractiveServer
@attribute [StreamRendering]



<h3>Registrar Usuario</h3>

<EditForm Model="@user"> 
    <DataAnnotationsValidator/>
    <div class="form-group d-flex flex-column">
        <label>
            <span>Username</span>
            <InputText class="form-control" @bind-Value="user.UserName" />
            <ValidationMessage For="() => user.UserName" class="alert alert-danger" />
        </label>
        <label>
            <span>Password</span>
            <InputText class="form-control" @bind-Value="user.Password" />
            <ValidationMessage For="() => user.Password" class="alert alert-danger" />
        </label>
    </div>
    <ValidationSummary></ValidationSummary>

</EditForm> 

<div class="btn-group" role="group" aria-label="Basic example">
    <button class="btn btn-secondary" @onclick=Register >Registrarse</button>
    <button class="btn btn-secondary" @onclick=Clear >Limpiar</button>
</div>

<div class="@claseMensaje" role="alert">
    <h4>@mensaje</h4>
</div>







